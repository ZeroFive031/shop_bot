# Скопируй этот файл в .env и заполни. Сам .env никогда не выкладывай в git!

# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Telegram ID продавцов/админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111

SHOP_NAME=Кофейная лавка

# Платёжный токен: @BotFather → твой бот → Payments → ЮKassa → Connect ЮKassa Test.
# Тестовый токен содержит слово TEST, деньги по нему не списываются.
# Если оставить пустым, оплата пойдёт в Telegram Stars — это НАСТОЯЩИЕ звёзды.
PAYMENT_TOKEN=
# Сколько рублей стоит одна звезда (нужно только для оплаты звёздами)
STAR_RATE_RUB=1.5

DB_PATH=shop.db
